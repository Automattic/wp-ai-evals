{
    "name": "automattic/ai-evals",
    "description": "A development-only evaluation harness for WordPress AI plugins.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "ai",
        "evals",
        "wordpress",
        "wp-cli"
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "automattic/vipwpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha",
        "phpunit/phpunit": "^9.6",
        "slevomat/coding-standard": "^8.0",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Automattic\\AiEvals\\": "includes/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Automattic\\AiEvals\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude node_modules .",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test": "phpunit",
        "check": [
            "@lint",
            "@phpcs",
            "@test"
        ]
    }
}
